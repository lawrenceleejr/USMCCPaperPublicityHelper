{
  "name": "usmcc-publicity-helper",
  "productName": "USMCC Publicity Helper",
  "version": "0.2.0",
  "description": "Turn a USMCC paper into social posts and an image carousel: photos, figures and PDF pages, text and the USMCC look, exported for phones.",
  "license": "MIT",
  "repository": "github:lawrenceleejr/USMCCPaperPublicityHelper",
  "private": true,
  "scripts": {
    "build:cli": "cargo build --release --no-default-features --manifest-path src-tauri/Cargo.toml",
    "start": "cargo run --release --no-default-features --manifest-path src-tauri/Cargo.toml -- --serve",
    "app": "tauri dev",
    "dist": "tauri build",
    "tauri": "tauri",
    "test": "node --test test/*.test.js",
    "test:ui": "node --test --test-concurrency=1 test/ui/*.test.js",
    "lite": "node scripts/build-lite.mjs && node scripts/serve-lite.mjs",
    "build:lite": "node scripts/build-lite.mjs",
    "test:lite": "node --test --test-concurrency=1 test/ui/lite.test.js",
    "samples": "node scripts/samples.mjs"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "playwright": "^1.63.0"
  }
}
