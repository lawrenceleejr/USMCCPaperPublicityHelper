{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "USMCC Publicity Helper",
  "version": "0.2.0",
  "identifier": "com.usmcc.publicity-helper",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "windows": [],
